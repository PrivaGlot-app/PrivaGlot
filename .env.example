# ===== MiMo API (LLM / ASR / TTS share one key) =====
# 获取方式见 README「第三步」；注册引导的文案来源
# 是 app/vendors/mimo.py（单一事实源，网页/飞书/文档共同渲染）。
#   sk-xxxxx  -> 按量付费（默认，推荐）
#   tp-xxxxx  -> Token Plan（仅开发者，见 README「Token Plan 接入」）
# 注意：在网页引导层 / 飞书卡片里填的 Key 会写进 data/.env，它的优先级
# 高于本文件（见 README「环境变量」优先级说明）；在本文件手工填 Key 仍有效。
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ===== Vendor =====
# 激活哪家供应商档案（app/vendors/<id>.py）。留空 = mimo。
# 改档案后跑一次 python setup/sync_guidance.py 刷新 README 的标记段落。
# VENDOR_ID=mimo

# ===== Multi-vendor models (#15: LLM/TTS/ASR 可按模态换厂商) =====
# 留空 = 默认小米（现状不变）。LLM_MODEL / LLM_BASE_URL 是跨厂商逃生门。
# LLM_VENDOR=zhipu
# TTS_VENDOR=zhipu
# ASR_VENDOR=zhipu
# 智谱 API Key（open.bigmodel.cn -> API Keys，形如 id.secret；同厂商三模态共用）：
# ZHIPU_API_KEY=

# ===== Models =====
LLM_MODEL=mimo-v2.6-flash
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts

# ===== Generation =====
# Hard cap on tokens per teacher turn - stops runaway generation.
LLM_MAX_TOKENS_PER_TURN=300

# ===== Server =====
# 监听地址钉死 127.0.0.1（网页只属于本机，见 app/config.py），只有端口可配。
SERVER_PORT=8000

# ===== Audio =====
SAMPLE_RATE=16000
CHANNELS=1

# ===== Debug =====
# 1 = write every full LLM prompt+response into data/prompt_logs/
# (contains student utterances — keep it 0 unless you are debugging)
DEBUG_PROMPTS=0

# ===== Feishu channel (v4, optional) =====
# 企业自建应用凭据，申请步骤见 docs/飞书接入.md。留空 = 飞书通道不启动。
# 机器人走 WebSocket 长连接，不需要域名/HTTPS/备案。
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# 海外版 Lark 把域名换成 https://open.larksuite.com
# FEISHU_DOMAIN=https://open.feishu.cn
# 会话空闲多少秒后，下一条消息先自动下课再开新课（默认 2 小时）
# FEISHU_SESSION_IDLE_TIMEOUT=7200
# 部署者的 open_id：扫码部署时自动写入，唯一用途=开机推送引导卡。
# 管理指令（状态/换Key/教材管理）已全员开放，本键不承担权限职能；
# 手动建应用的把部署者自己的 open_id 直接填在这里。
# FEISHU_ADMIN_OPEN_ID=ou_xxxxxxxx
